# Preencher apenas em Vercel > Project > Settings > Environment Variables.
# NUNCA criar .env real no repositório.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
APP_PUBLIC_URL=https://impressao3d-rho.vercel.app
APP_ADMIN_TOKEN=
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BLING_TOKEN_ENCRYPTION_KEY=
# Upstash Redis REST do seu projeto Vercel / Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Opcional: apenas se encontrar ID da loja na resposta da API Bling.
# NÃO confundir com 'Código da loja API Bling' nem Shop ID da Shopee.
BLING_SHOPEE_ID_LOJA=
